{
  // Venv selection (written by the Python Environments extension)
  "python-envs.pythonProjects": [
    {
      "path": ".",
      "envManager": "ms-python.python:venv",
      "packageManager": "ms-python.python:pip"
    }
  ],

  // Interpreter default for fresh clones/machines
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // Explicit interpreter for the tool extensions — fixes them falling back
  // to the system Python 3.9 (/usr/bin/python3)
  "black-formatter.interpreter": [ "${workspaceFolder}/.venv/bin/python" ],
  "isort.interpreter": [ "${workspaceFolder}/.venv/bin/python" ],

  // Python formatting
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true
  },

  // isort — Black-compatible import sorting (Shift+Option+O)
  "isort.args": [ "--profile", "black" ],

  // Visual guide at Black's 88-char line length
  "editor.rulers": [ 88 ],

  // Keep files clean on save (applies to XML/JSON too)
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // JSON formatting for mappings/configs/expressions files
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },

  // Keep searches out of the venv (add generated output path if applicable)
  "search.exclude": {
    "**/__pycache__": true,
    "**/.venv": true
  },
  "files.exclude": {
    "**/__pycache__": true
  }
}
