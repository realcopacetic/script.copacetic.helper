<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<addon id="script.copacetic.helper" name="Copacetic Helper" version="1.1.13" provider-name="realcopacetic">
  <requires>
    <import addon="xbmc.python" version="3.0.1" />
    <import addon="script.module.pil" version="5.1.0" />
  </requires>
  <extension point="xbmc.python.pluginsource" library="plugin.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py" />
  <extension point="xbmc.python.script" library="script.py">
    <provides>executable</provides>
  </extension>
  <extension point="kodi.context.item">
    <menu id="kodi.core.main">
      <!-- Shuffle to Unlike test helper_active: set by the service only while an opted-in
           skin is active (service/monitor.py), so the items never show in other skins -->
      <item library="context.py" args="action=shuffle">
        <label>32820</label>
        <visible>!String.IsEmpty(Window(home).Property(helper_active)) + String.IsEmpty(ListItem.Property(speed_dial)) + [[Integer.IsGreater(ListItem.DBID,0) + [String.IsEqual(ListItem.DBType,artist) | String.IsEqual(ListItem.DBType,album) | [String.IsEqual(ListItem.DBType,genre) + !String.IsEmpty(ListItem.Genre)]]] | [String.StartsWith(ListItem.FolderPath,musicdb://) + [String.IsEqual(ListItem.DBType,year) | String.IsEqual(ListItem.DBType,originalyear)]] | [[String.StartsWith(ListItem.FolderPath,special://musicplaylists/) | String.StartsWith(ListItem.FolderPath,special://profile/playlists/music/)] + [String.EndsWith(ListItem.FolderPath,.xsp) | String.EndsWith(ListItem.FolderPath,.m3u)]]]</visible>
      </item>
      <item library="context.py" args="action=start_mix">
        <label>32821</label>
        <visible>!String.IsEmpty(Window(home).Property(helper_active)) + String.IsEmpty(ListItem.Property(speed_dial)) + [[Integer.IsGreater(ListItem.DBID,0) + [String.IsEqual(ListItem.DBType,song) | String.IsEqual(ListItem.DBType,artist) | String.IsEqual(ListItem.DBType,album) | [String.IsEqual(ListItem.DBType,genre) + !String.IsEmpty(ListItem.Genre)]]] | [String.StartsWith(ListItem.FolderPath,musicdb://) + [String.IsEqual(ListItem.DBType,year) | String.IsEqual(ListItem.DBType,originalyear)]]]</visible>
      </item>
      <item library="context.py" args="action=rate_song">
        <label>32822</label>
        <visible>!String.IsEmpty(Window(home).Property(helper_active)) + Integer.IsGreater(ListItem.DBID,0) + String.IsEqual(ListItem.DBType,song) + Integer.IsGreater(Skin.String(like_threshold),0) + Integer.IsLess(ListItem.UserRating,Skin.String(like_threshold))</visible>
      </item>
      <item library="context.py" args="action=rate_song,rating=0">
        <label>32823</label>
        <visible>!String.IsEmpty(Window(home).Property(helper_active)) + Integer.IsGreater(ListItem.DBID,0) + String.IsEqual(ListItem.DBType,song) + Integer.IsGreater(Skin.String(like_threshold),0) + !Integer.IsLess(ListItem.UserRating,Skin.String(like_threshold))</visible>
      </item>
      <!-- Pin/Unpin test helper_speed_dial: set with helper_active, only while the skin names
           info=speed_dial in its templates or XML (shared/speed_dial.py skin_uses_speed_dial) -->
      <!-- Pinned state: speed_dial_<type><digits> and speed_dial_playlist hold the pinned keys
           (shared/speed_dial.py publish); one property per ID length, so only a whole ID matches -->
      <item library="context.py" args="action=pin">
        <label>32824</label>
        <visible>!String.IsEmpty(Window(home).Property(helper_speed_dial)) + [[Integer.IsGreater(ListItem.DBID,0) + [[String.IsEqual(ListItem.DBType,song) + ![String.Contains(Window(home).Property(speed_dial_song1),ListItem.DBID) | [Integer.IsGreater(ListItem.DBID,9) + String.Contains(Window(home).Property(speed_dial_song2),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,99) + String.Contains(Window(home).Property(speed_dial_song3),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,999) + String.Contains(Window(home).Property(speed_dial_song4),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,9999) + String.Contains(Window(home).Property(speed_dial_song5),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,99999) + String.Contains(Window(home).Property(speed_dial_song6),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,999999) + String.Contains(Window(home).Property(speed_dial_song7),ListItem.DBID)]]] | [String.IsEqual(ListItem.DBType,artist) + ![String.Contains(Window(home).Property(speed_dial_artist1),ListItem.DBID) | [Integer.IsGreater(ListItem.DBID,9) + String.Contains(Window(home).Property(speed_dial_artist2),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,99) + String.Contains(Window(home).Property(speed_dial_artist3),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,999) + String.Contains(Window(home).Property(speed_dial_artist4),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,9999) + String.Contains(Window(home).Property(speed_dial_artist5),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,99999) + String.Contains(Window(home).Property(speed_dial_artist6),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,999999) + String.Contains(Window(home).Property(speed_dial_artist7),ListItem.DBID)]]] | [String.IsEqual(ListItem.DBType,album) + ![String.Contains(Window(home).Property(speed_dial_album1),ListItem.DBID) | [Integer.IsGreater(ListItem.DBID,9) + String.Contains(Window(home).Property(speed_dial_album2),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,99) + String.Contains(Window(home).Property(speed_dial_album3),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,999) + String.Contains(Window(home).Property(speed_dial_album4),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,9999) + String.Contains(Window(home).Property(speed_dial_album5),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,99999) + String.Contains(Window(home).Property(speed_dial_album6),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,999999) + String.Contains(Window(home).Property(speed_dial_album7),ListItem.DBID)]]]]] | [[String.StartsWith(ListItem.FolderPath,special://musicplaylists/) | String.StartsWith(ListItem.FolderPath,special://profile/playlists/music/)] + [String.EndsWith(ListItem.FolderPath,.xsp) | String.EndsWith(ListItem.FolderPath,.m3u)] + !String.Contains(Window(home).Property(speed_dial_playlist),ListItem.FolderPath)]]</visible>
      </item>
      <item library="context.py" args="action=unpin">
        <label>32825</label>
        <visible>!String.IsEmpty(Window(home).Property(helper_speed_dial)) + String.IsEmpty(ListItem.Property(speed_dial)) + [[Integer.IsGreater(ListItem.DBID,0) + [[String.IsEqual(ListItem.DBType,song) + [String.Contains(Window(home).Property(speed_dial_song1),ListItem.DBID) | [Integer.IsGreater(ListItem.DBID,9) + String.Contains(Window(home).Property(speed_dial_song2),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,99) + String.Contains(Window(home).Property(speed_dial_song3),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,999) + String.Contains(Window(home).Property(speed_dial_song4),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,9999) + String.Contains(Window(home).Property(speed_dial_song5),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,99999) + String.Contains(Window(home).Property(speed_dial_song6),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,999999) + String.Contains(Window(home).Property(speed_dial_song7),ListItem.DBID)]]] | [String.IsEqual(ListItem.DBType,artist) + [String.Contains(Window(home).Property(speed_dial_artist1),ListItem.DBID) | [Integer.IsGreater(ListItem.DBID,9) + String.Contains(Window(home).Property(speed_dial_artist2),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,99) + String.Contains(Window(home).Property(speed_dial_artist3),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,999) + String.Contains(Window(home).Property(speed_dial_artist4),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,9999) + String.Contains(Window(home).Property(speed_dial_artist5),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,99999) + String.Contains(Window(home).Property(speed_dial_artist6),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,999999) + String.Contains(Window(home).Property(speed_dial_artist7),ListItem.DBID)]]] | [String.IsEqual(ListItem.DBType,album) + [String.Contains(Window(home).Property(speed_dial_album1),ListItem.DBID) | [Integer.IsGreater(ListItem.DBID,9) + String.Contains(Window(home).Property(speed_dial_album2),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,99) + String.Contains(Window(home).Property(speed_dial_album3),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,999) + String.Contains(Window(home).Property(speed_dial_album4),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,9999) + String.Contains(Window(home).Property(speed_dial_album5),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,99999) + String.Contains(Window(home).Property(speed_dial_album6),ListItem.DBID)] | [Integer.IsGreater(ListItem.DBID,999999) + String.Contains(Window(home).Property(speed_dial_album7),ListItem.DBID)]]]]] | [[String.StartsWith(ListItem.FolderPath,special://musicplaylists/) | String.StartsWith(ListItem.FolderPath,special://profile/playlists/music/)] + [String.EndsWith(ListItem.FolderPath,.xsp) | String.EndsWith(ListItem.FolderPath,.m3u)] + String.Contains(Window(home).Property(speed_dial_playlist),ListItem.FolderPath)]]</visible>
      </item>
    </menu>
  </extension>
  <extension point="xbmc.addon.metadata">
    <platform>all</platform>
    <license>GPL-3.0-or-later</license>
    <assets>
      <icon>resources/icon.png</icon>
      <fanart>resources/fanart.jpg</fanart>
    </assets>
    <summary lang="en_GB">The engine behind the Copacetic 2 skin.</summary>
    <description lang="en_GB">Copacetic Helper powers the Copacetic 2 skin. It builds the skin's layouts from your settings, prepares artwork such as blurred backgrounds, adds extra library listings, and looks after trailers, play next and the background slideshow.[CR][CR]Add your own TMDB and ListenBrainz tokens in the settings for extra art, trailers, top songs and more. Leave them empty and the helper makes no calls to either service.[CR][CR]Skin developers can use it in their own skins: guides are in the add-on's resources/docs folder.[CR][CR]This product uses the TMDB API but is not endorsed or certified by TMDB (https://www.themoviedb.org).</description>
  </extension>
</addon>
