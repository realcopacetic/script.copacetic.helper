msgid "Enabled"
msgstr "Activado"

#. A toast (one line, cut if long): keep it short.
#: /resources/lib/script/actions.py
msgctxt "#32207"
msgid "Skin reset and rebuilt"
msgstr "Skin restablecido y reconstruido"

#. A toast (one line, cut if long): keep it short.
#: /resources/lib/script/actions.py
