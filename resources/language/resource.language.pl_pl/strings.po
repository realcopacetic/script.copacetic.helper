#########################################################################################################

#: SETTINGS HELP         321XX
# Help text under a setting: id = the setting's label id + 100

#########################################################################################################

#: /resources/settings.xml
msgctxt "#32103"
msgid "Diagnostic and informational logs will be included in the Kodi log file to help troubleshooting."
msgstr "Komunikaty diagnostyczne i informacyjne będą zapisywane w pliku dziennika Kodi, aby ułatwić rozwiązywanie problemów."

#: /resources/settings.xml
msgctxt "#32104"
msgid "Whenever Kodi's internal database is queried by the add-on using JSON-RPC, the queries and responses will also be logged."
msgstr "Gdy dodatek odpytuje wewnętrzną bazę danych Kodi przez JSON-RPC, zapytania i odpowiedzi również będą rejestrowane."

#: /resources/settings.xml
msgctxt "#32107"
msgid "This will force all skin builder files to be rebuilt every time Kodi starts."
msgstr "Wymusza przebudowanie wszystkich plików budowania skóry przy każdym uruchomieniu Kodi."

#. Keep themoviedb.org as it is.
#: /resources/settings.xml
msgctxt "#32110"
msgid "Adds TV creators, trailers, missing plots and taglines, and extra art. Paste your own v3 API key or v4 read access token from themoviedb.org. Sends the item's TMDB ID to TMDB. Empty: nothing sent."
msgstr "Dodaje twórców seriali, zwiastuny, brakujące opisy i hasła reklamowe oraz dodatkowe grafiki. Wklej własny klucz API v3 lub token dostępu do odczytu v4 z themoviedb.org. Wysyła do TMDB identyfikator TMDB elementu. Puste: nic nie jest wysyłane."

#. runtime_state is a file's name: keep it as it is.
#: /resources/settings.xml
msgctxt "#32112"
msgid "Clears runtime_state and all builder outputs of the skin you turn this on in, next time that skin starts, then rebuilds from defaults. The toggle reverts itself once applied. To move it to another skin, turn it off and press OK, then turn it on again."
msgstr "Czyści runtime_state i wszystkie wyniki budowania skóry, w której to włączysz, przy następnym uruchomieniu tej skóry, a potem buduje je od nowa z ustawień domyślnych. Przełącznik wyłącza się sam po zastosowaniu. Aby przenieść go do innej skóry, wyłącz go i naciśnij OK, a następnie włącz ponownie."

#. runtime_state is a file's name: keep it as it is.
#: /resources/settings.xml
msgctxt "#32113"
msgid "Rebuild all skin output files immediately and reload the skin. Preserves runtime_state."
msgstr "Natychmiast przebuduj wszystkie pliki wynikowe skóry i przeładuj skórę. Zachowuje runtime_state."

#: /resources/settings.xml
msgctxt "#32114"
msgid "Verify the current token by making a test request and report the result."
msgstr "Sprawdź bieżący token, wysyłając zapytanie testowe, i pokaż wynik."

#. Keep the codes 'en-US', 'fr-FR' and 'de-DE' as they are.
#: /resources/settings.xml
msgctxt "#32115"
msgid "Language code for TMDB metadata, e.g. 'en-US', 'fr-FR', 'de-DE'."
msgstr "Kod języka dla metadanych TMDB, np. 'en-US', 'fr-FR', 'de-DE'."

#: /resources/settings.xml
msgctxt "#32119"
msgid "Delete all processed artwork (blurred, cropped, text images), reset the artwork lookup database, and forget saved web service answers (TMDB, ListenBrainz, Deezer, TheIntroDB, LRCLIB), the daily mix cards' kept mixes and saved text truncations. Asks first. Source artwork is unaffected."
msgstr "Usuń całą przetworzoną grafikę (rozmyte, przycięte i tekstowe obrazy), zresetuj bazę wyszukiwania grafik i zapomnij zapisane odpowiedzi serwisów (TMDB, ListenBrainz, Deezer, TheIntroDB, LRCLIB), zachowane miksy kart codziennych miksów oraz zapisane skrócenia tekstu. Najpierw pyta. Grafika źródłowa pozostaje nietknięta."

#: /resources/settings.xml
msgctxt "#32120"
msgid "Logs every per-item builder operation (default applications, fallback resolutions). Very noisy — only useful when debugging template/mapping issues."
msgstr "Rejestruje każdą operację budowania dla poszczególnych elementów (domyślne zastosowania, rozwiązania awaryjne). Bardzo obszerne — przydatne tylko przy diagnozowaniu problemów z szablonami/mapowaniami."

#. "Top songs", "Discography" and "Start mix" (#32821) are the skin's and the helper's own labels:
#. use their translations. Keep listenbrainz.org/settings.
#: /resources/settings.xml
msgctxt "#32121"
msgid "Adds Top songs, Discography popularity order and similar artists (the similar rails, Start mix, the endless queue and daily mixes). Paste the token from listenbrainz.org/settings. Sends the artist's MusicBrainz ID and token to ListenBrainz. Empty: nothing sent."
msgstr "Dodaje Najlepsze utwory, kolejność popularności w Dyskografii i podobnych wykonawców (rzędy podobnych, Uruchom miks, nieskończona kolejka i codzienne miksy). Wklej token z listenbrainz.org/settings. Wysyła do ListenBrainz identyfikator MusicBrainz wykonawcy i token. Puste: nic nie jest wysyłane."

#: /resources/settings.xml
msgctxt "#32125"
msgid "Remove the current artwork of every artist or album in Kodi's list, so refreshing them all fills it again from the folders and the information provider. Image files are not touched."
msgstr "Usuń bieżącą grafikę każdego wykonawcy lub albumu z listy Kodi, aby odświeżenie wszystkich wypełniło ją ponownie z folderów i od dostawcy informacji. Pliki obrazów pozostają nietknięte."

#. "Asks first": the action shows a yes/no question before it removes anything.
#: /resources/settings.xml
msgctxt "#32127"
msgid "Check every artwork link of artists, albums, movies, sets, TV shows and seasons, then remove the dead ones (web images no longer there, files moved or deleted). Run it on a device whose share login can read every art folder. Asks first; an artist it changes loses its discography and music video links until refreshed."
msgstr "Sprawdź każdy link do grafiki wykonawców, albumów, filmów, serii filmowych, seriali i sezonów, a następnie usuń martwe (obrazy z sieci, których już nie ma, przeniesione lub usunięte pliki). Uruchom na urządzeniu, którego dane logowania do udziałów pozwalają odczytać każdy folder z grafiką. Najpierw pyta; zmieniony wykonawca traci linki do dyskografii i teledysków do czasu odświeżenia."

#: /resources/settings.xml
msgctxt "#32128"
msgid "Remove this device's cached copies of images that no library item uses and that haven't been shown for 30 days. Asks first. Each Kodi device keeps its own cache."
msgstr "Usuń z pamięci podręcznej tego urządzenia kopie obrazów, których nie używa żaden element biblioteki i które nie były wyświetlane od 30 dni. Najpierw pyta. Każde urządzenie z Kodi ma własną pamięć podręczną."

#. "Refresh cached data" is string #32835: use the same words.
#: /resources/settings.xml
msgctxt "#32133"
msgid "Forget every saved TMDB answer (details, cast, artwork links), so each is fetched again when next shown. One item: Refresh cached data in its context menu."
msgstr "Zapomnij wszystkie zapisane odpowiedzi TMDB (szczegóły, obsada, linki do grafik), aby każda została pobrana ponownie przy następnym wyświetleniu. Jeden element: Odśwież zapisane dane w jego menu kontekstowym."

#. "Refresh cached data" is string #32835: use the same words.
#: /resources/settings.xml
msgctxt "#32134"
msgid "Forget every saved ListenBrainz answer (top songs, similar artists), so each is fetched again when next shown. One artist: Refresh cached data in its context menu."
msgstr "Zapomnij wszystkie zapisane odpowiedzi ListenBrainz (najlepsze utwory, podobni wykonawcy), aby każda została pobrana ponownie przy następnym wyświetleniu. Jeden wykonawca: Odśwież zapisane dane w jego menu kontekstowym."

#. "Refresh cached data" is string #32835: use the same words.
#: /resources/settings.xml
msgctxt "#32136"
msgid "Forget every saved Deezer answer (matched artists, top tracks, similar artists, today's chart), so each is fetched again when next shown. One artist: Refresh cached data in its context menu."
msgstr "Zapomnij wszystkie zapisane odpowiedzi Deezer (dopasowani wykonawcy, najlepsze utwory, podobni wykonawcy, dzisiejsza lista przebojów), aby każda została pobrana ponownie przy następnym wyświetleniu. Jeden wykonawca: Odśwież zapisane dane w jego menu kontekstowym."

#. "Charting" (#32995), "Popular" (#32996), "Your #3 artist" (#32999), "Your most played album"
#. (#32994), "Your #2 song" (#32993) and "Start mix" (#32821) are the helper's own labels: use the
#. same words as those strings.
#: /resources/settings.xml
msgctxt "#32138"
msgid "Orders Top songs and Discography (Popularity) by what is streamed on Deezer now, alone or blended with ListenBrainz; finds similar artists (the similar rails, Start mix, the endless queue and daily mixes); labels music info Charting or Popular. Sends the artist's name to Deezer and asks for its chart once a day; no account needed. Off: nothing sent, and music info says Your #3 artist, Your most played album or Your #2 song from your plays."
msgstr "Porządkuje Najlepsze utwory i Dyskografię (Popularność) według tego, czego teraz słucha się na Deezer, samodzielnie lub łącznie z ListenBrainz; znajduje podobnych wykonawców (rzędy podobnych, Uruchom miks, nieskończona kolejka i codzienne miksy); oznacza informacje o muzyce etykietą Na listach lub Popularny. Wysyła do Deezer nazwę wykonawcy i raz dziennie pobiera listę przebojów; konto nie jest wymagane. Wyłączone: nic nie jest wysyłane, a informacje o muzyce pokazują Twój wykonawca nr 3, Twój najczęściej odtwarzany album lub Twój utwór nr 2 na podstawie twoich odtworzeń."

#. "Play next" is the skin's own label. Keep theintrodb.org as it is.
#: /resources/settings.xml
msgctxt "#32140"
msgid "Where a library movie's or episode's intro, recap and credits are, for the skin's skip button and Play next. Times come from TheIntroDB (theintrodb.org), sent the movie's or show's ids and the episode's number; no account needed. Off: nothing sent, and only chapters are used."
msgstr "Gdzie w filmie lub odcinku z biblioteki są czołówka, streszczenie i napisy końcowe, dla przycisku pomijania w skórze i Odtwórz następny. Czasy pochodzą z TheIntroDB (theintrodb.org), do którego wysyłane są identyfikatory filmu lub serialu i numer odcinka; konto nie jest wymagane. Wyłączone: nic nie jest wysyłane i używane są tylko rozdziały."

#. "Refresh cached data" is string #32835: use the same words.
#: /resources/settings.xml
msgctxt "#32141"
msgid "Forget every saved TheIntroDB answer (intro, recap and credits times), so each is fetched again when next played. One movie or show: Refresh cached data in its context menu."
msgstr "Zapomnij wszystkie zapisane odpowiedzi TheIntroDB (czasy czołówek, streszczeń i napisów końcowych), aby każda została pobrana ponownie przy następnym odtworzeniu. Jeden film lub serial: Odśwież zapisane dane w jego menu kontekstowym."

#. Keep .lrc and lrclib.net as they are.
#: /resources/settings.xml
msgctxt "#32143"
msgid "Lyrics for the playing song, when it has no .lrc file beside it and none in its tags, for the skin's lyrics. They come from LRCLIB (lrclib.net), sent the song's title, artist, album and length. The next song in the queue is asked ahead too, even when it has lyrics of its own. No account needed. Off: nothing sent, and only .lrc files and tags are used."
msgstr "Tekst odtwarzanego utworu, gdy nie ma obok niego pliku .lrc ani tekstu w znacznikach, dla tekstów wyświetlanych przez skórę. Pochodzi z LRCLIB (lrclib.net), do którego wysyłany jest tytuł, wykonawca, album i długość utworu. Następny utwór w kolejce jest sprawdzany z wyprzedzeniem, nawet gdy ma własny tekst. Konto nie jest wymagane. Wyłączone: nic nie jest wysyłane i używane są tylko pliki .lrc i znaczniki."

#: /resources/settings.xml
msgctxt "#32144"
msgid "Forget every saved LRCLIB answer (song lyrics), so each is fetched again when next played."
msgstr "Zapomnij wszystkie zapisane odpowiedzi LRCLIB (teksty utworów), aby każda została pobrana ponownie przy następnym odtworzeniu."

#: /resources/settings.xml
msgctxt "#32146"
msgid "Switches back on each add-on the helper switched off for doing a job the skin already does (lyrics, next episode prompts, skip buttons), and asks about each again once Home is shown."
msgstr "Ponownie włącza każdy dodatek, który dodatek pomocniczy wyłączył, bo wykonywał zadanie, które skóra już wykonuje (teksty utworów, monity o następnym odcinku, przyciski pomijania), i pyta o każdy ponownie po wyświetleniu ekranu startowego."

#. "Look up art details" is string #32847: use the same words. Keep Wikidata and Wikipedia as they are.
#: /resources/settings.xml
msgctxt "#32148"
msgid "Artist, year, medium, collection, size and a summary for paintings in your picture folders, from Wikidata and Wikipedia. Only in folders you choose: Look up art details in a folder's context menu. A file is matched by its name, as Artist - Title (Year), when you first rest on it; the name is sent to Wikidata. No account needed. Off: nothing sent."
msgstr "Artysta, rok, technika, kolekcja, wymiary i streszczenie dla obrazów w Twoich folderach ze zdjęciami, z Wikidata i Wikipedii. Tylko w wybranych folderach: Wyszukaj szczegóły dzieła w menu kontekstowym folderu. Plik jest rozpoznawany po nazwie, w postaci Artysta - Tytuł (Rok), gdy po raz pierwszy się na nim zatrzymasz; nazwa jest wysyłana do Wikidata. Konto nie jest wymagane. Wyłączone: nic nie jest wysyłane."

#: /resources/settings.xml
msgctxt "#32149"
msgid "Forget every saved Wikidata answer (paintings matched or not), so each picture is looked up again when next shown."
msgstr "Zapomnij wszystkie zapisane odpowiedzi Wikidata (obrazy rozpoznane lub nie), aby każde zdjęcie zostało wyszukane ponownie przy następnym wyświetleniu."




#########################################################################################################

#: DIALOGS AND TOASTS    322XX
# Questions, progress text and toasts of the settings' actions

#########################################################################################################

#. %s is a size, e.g. "1.2 MB". A toast (one line, cut if long): keep it short. Keep %s; write a literal % as %%.
#: /resources/lib/shared/utilities.py
msgctxt "#32201"
msgid "Cache cleared, %s freed"
msgstr "Wyczyszczono, zwolniono %s"

#. A toast under an add-on's id, after it is switched off.
#: /resources/lib/script/actions.py
msgctxt "#32205"
msgid "Disabled"
msgstr "Wyłączono"

