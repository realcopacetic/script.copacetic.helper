#: /resources/lib/plugin/handlers.py
#: /resources/lib/plugin/listing.py
msgctxt "#32836"
msgid "Rediscover"
msgstr "Odkryj na nowo"

#. The name of a row of items, shown as its heading: keep it short.
#: /resources/lib/plugin/handlers.py
msgctxt "#32837"
msgid "Daily mixes"
msgstr "Codzienne miksy"

