#: /resources/lib/script/actions.py
msgctxt "#32209"
msgid "TMDB token valid"
msgstr "Token TMDB prawidłowy"

#. A toast (one line, cut if long): keep it short.
#: /resources/lib/script/actions.py
msgctxt "#32210"
msgid "TMDB test failed — check token and network"
msgstr "Test TMDB nieudany — sprawdź token i sieć"

#. A toast (one line, cut if long): keep it short.
#: /resources/lib/script/actions.py
msgctxt "#32211"
msgid "Skin rebuilt"
msgstr "Skórę przebudowano"

#. A toast (one line, cut if long): keep it short.
#: /resources/lib/script/actions.py
msgctxt "#32212"
msgid "No ListenBrainz token set"
msgstr "Nie ustawiono tokenu ListenBrainz"

#. A toast (one line, cut if long): keep it short.
#: /resources/lib/script/actions.py
msgctxt "#32213"
msgid "ListenBrainz token valid"
msgstr "Token ListenBrainz prawidłowy"

#. A toast (one line, cut if long): keep it short.
#: /resources/lib/script/actions.py
msgctxt "#32214"
msgid "ListenBrainz test failed — check token and network"
msgstr "Test ListenBrainz nieudany — sprawdź token i sieć"

#. A toast (one line, cut if long): keep it short.
#: /resources/lib/shared/utilities.py
msgctxt "#32215"
msgid "Skin build failed — check the log"
msgstr "Błąd budowania skóry — sprawdź dziennik"

#. %d is a number of artists or albums. A toast (one line, cut if long): keep it short.
#: /resources/lib/script/actions.py
msgctxt "#32216"
msgid "Artwork cleared for %d items"
msgstr "Wyczyszczono grafikę, elementy: %d"

#. First %d: a number of images; second %d: a number of library items. %s is empty, or a space and
#. string #32228 in its brackets: keep it straight after the items, before the full stop. "Show song
#. and album artists" is Kodi's #13414: follow Kodi's translation; \" is a quotation mark.
#: /resources/lib/script/actions.py
msgctxt "#32218"
msgid "Found %d broken images on %d items%s. Remove them? An artist also loses its discography and music video links until refreshed (song-only artists need \"Show song and album artists\" on)."
msgstr "Znaleziono uszkodzone obrazy: %d, w elementach: %d%s. Usunąć je? Wykonawca traci też linki do dyskografii i teledysków do czasu odświeżenia (wykonawcy samych utworów wymagają włączenia „Pokazuj wykonawców utworów i albumów”)."

#. A toast (one line, cut if long): keep it short.
#: /resources/lib/script/actions.py
msgctxt "#32219"
msgid "No broken artwork found"
msgstr "Nie znaleziono uszkodzonej grafiki"

#. A toast (one line, cut if long): keep it short.
#: /resources/lib/script/actions.py
msgctxt "#32220"
msgid "No internet connection, nothing removed"
msgstr "Brak połączenia z internetem, nic nie usunięto"

#. %d is a number of images. A toast (one line, cut if long): keep it short.
#: /resources/lib/script/actions.py
msgctxt "#32221"
msgid "Removed %d broken images"
msgstr "Usunięto uszkodzone obrazy: %d"

#. %d is a number of images and %.0f their size in megabytes: keep both exactly (%.0f prints a whole
#. number).
#: /resources/lib/script/actions.py
msgctxt "#32222"
msgid "Found %d cached images (%.0f MB) that nothing has used for 30 days. Remove them?"
msgstr "Znaleziono obrazy w pamięci podręcznej: %d (%.0f MB), nieużywane od 30 dni. Usunąć je?"

#. %d is a number of images. A toast (one line, cut if long): keep it short.
#: /resources/lib/script/actions.py
msgctxt "#32223"
msgid "Removed %d cached images"
msgstr "Usunięto zbuforowane obrazy: %d"

#. A progress dialog's line.
#: /resources/lib/script/actions.py
msgctxt "#32224"
msgid "Reading the library…"
msgstr "Odczytywanie biblioteki…"

#. %d is a number of images. A progress dialog's line.
#: /resources/lib/script/actions.py
msgctxt "#32225"
msgid "Checking %d images…"
msgstr "Sprawdzanie obrazów: %d…"

#. A toast (one line, cut if long): keep it short.
#: /resources/lib/script/actions.py
msgctxt "#32226"
msgid "Nothing to clean"
msgstr "Nic do wyczyszczenia"

#. %s is a list of server names, e.g. "nas.local, 192.168.1.5"; %d is a number of images.
#: /resources/lib/script/actions.py
msgctxt "#32227"
msgid "No longer found by name: %s, for %d images. Include those images? Say no if any is a server only your network knows."
msgstr "Nie można już znaleźć po nazwie: %s, dla obrazów: %d. Uwzględnić te obrazy? Odpowiedz nie, jeśli którykolwiek z nich to serwer znany tylko twojej sieci."

#. %d is a number of artwork links. Shown after #32218, #32219, #32221 or #32229, so it stays in
#. brackets and starts in lower case.
#: /resources/lib/script/actions.py
msgctxt "#32228"
msgid "(%d skipped: their server didn't answer)"
msgstr "(pominięto: %d — ich serwer nie odpowiedział)"

#. A toast (one line, cut if long): keep it short.
#: /resources/lib/script/actions.py
msgctxt "#32229"
msgid "Nothing removed"
msgstr "Nic nie usunięto"

#. A toast (one line, cut if long): keep it short.
#: /resources/lib/script/actions.py
msgctxt "#32230"
msgid "Cleared"
msgstr "Wyczyszczono"

#. A toast (one line, cut if long): keep it short.
#: /resources/lib/script/actions.py
msgctxt "#32231"
msgid "Fetched again when next shown"
msgstr "Pobierane ponownie przy wyświetleniu"

#. A toast (one line, cut if long): keep it short.
#: /resources/lib/script/actions.py
msgctxt "#32232"
msgid "Nothing cached for this item"
msgstr "Brak zapisanych danych dla tego elementu"

#. "Waveform" is a visualisation add-on's name: do not translate. A toast (one line, cut if long):
#. keep it short.
#: /resources/lib/script/actions.py
msgctxt "#32233"
msgid "Waveform couldn't be switched on: the background stays as it is"
msgstr "Nie udało się włączyć Waveform: tło pozostaje bez zmian"

#. A dialog button: keep it short. Switches the other add-on off (see #32236).
#: /resources/lib/service/clashes.py
msgctxt "#32234"
msgid "Switch off"
msgstr "Wyłącz"

#. A dialog button: keep it short. Leaves the other add-on on (see #32236).
#: /resources/lib/service/clashes.py
msgctxt "#32235"
msgid "Keep both"
msgstr "Zachowaj oba"

#. %(addon)s is the other add-on's name and %(skin)s the skin's: keep both exactly, with the s after
#. the bracket.
#: /resources/lib/service/clashes.py
msgctxt "#32236"
msgid "%(addon)s opens its own lyrics over %(skin)s's. Switch it off while you use %(skin)s? It comes back on if you change skin."
msgstr "%(addon)s otwiera własne teksty utworów nad tekstami %(skin)s. Wyłączyć go podczas używania %(skin)s? Włączy się ponownie, jeśli zmienisz skórę."

#. %(addon)s is the other add-on's name and %(skin)s the skin's: keep both exactly, with the s after
#. the bracket. "Play next" is the skin's own label.
#: /resources/lib/service/clashes.py
msgctxt "#32237"
msgid "%(addon)s shows its own next episode prompt as well as %(skin)s's Play next. It also covers episodes from other add-ons, which Play next doesn't. Switch it off while you use %(skin)s? It comes back on if you change skin."
msgstr "%(addon)s pokazuje własny monit o następnym odcinku oprócz Odtwórz następny w %(skin)s. Obsługuje też odcinki z innych dodatków, czego Odtwórz następny nie robi. Wyłączyć go podczas używania %(skin)s? Włączy się ponownie, jeśli zmienisz skórę."

#. %(addon)s is the other add-on's name and %(skin)s the skin's: keep both exactly, with the s after
#. the bracket.
#: /resources/lib/service/clashes.py
msgctxt "#32238"
msgid "%(addon)s shows its own skip and next episode buttons over %(skin)s's. Switch it off while you use %(skin)s? It comes back on if you change skin."
msgstr "%(addon)s pokazuje własne przyciski pomijania i następnego odcinka nad przyciskami %(skin)s. Wyłączyć go podczas używania %(skin)s? Włączy się ponownie, jeśli zmienisz skórę."

#. A dialog button: keep it short. Closes the question, which is asked again later (see #32236).
#: /resources/lib/service/clashes.py
msgctxt "#32239"
msgid "Not now"
msgstr "Nie teraz"

#: /resources/lib/script/actions.py
msgctxt "#32240"
msgid "Delete all processed artwork and forget every saved web service answer? Each is made or fetched again when next needed."
msgstr "Usunąć całą przetworzoną grafikę i zapomnieć wszystkie zapisane odpowiedzi serwisów? Każda zostanie utworzona lub pobrana ponownie, gdy będzie potrzebna."




