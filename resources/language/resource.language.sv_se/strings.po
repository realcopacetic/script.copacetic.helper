#: /resources/lib/script/actions.py
msgctxt "#32227"
msgid "No longer found by name: %s, for %d images. Include those images? Say no if any is a server only your network knows."
msgstr "Hittas inte längre via namn: %s, för %d bilder. Ta med de bilderna? Svara nej om någon är en server som bara ditt nätverk känner till."

