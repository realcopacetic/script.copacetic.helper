#: /resources/settings.xml
msgctxt "#32008"
msgid "API"
msgstr ""

#: /resources/settings.xml
msgctxt "#32009"
msgid "Enable access to TMDB API"
msgstr ""

#: /resources/settings.xml
msgctxt "#32109"
msgid "Adds details from TMDB (The Movie Database) that Kodi's library lacks: a TV show's creators, TV show trailers and, where the skin asks for it, extra artwork; plots and taglines then come from TMDB in the TMDB language. Needs your own TMDB API key or read access token. Sends the focused movie's or show's TMDB ID to api.themoviedb.org. Off: nothing is sent. This product uses the TMDB API but is not endorsed or certified by TMDB."
msgstr ""

#: /resources/settings.xml
msgctxt "#32010"
msgid "TMDB access token"
msgstr ""

#: /resources/settings.xml
msgctxt "#32110"
msgid "Paste either your TMDB v3 API Key or your v4 API Read Access Token. Copacetic supports both. Only one is required."
msgstr ""

#: /resources/settings.xml
msgctxt "#32011"
msgid "Enter a TMDB v3 API Key or v4 API Read Access Token"
msgstr ""

#: /resources/settings.xml
msgctxt "#32014"
msgid "Test TMDB access"
msgstr ""

#: /resources/settings.xml
msgctxt "#32114"
msgid "Verify the current token by making a test request and report the result."
msgstr ""

#: /resources/settings.xml
msgctxt "#32015"
msgid "TMDB language"
msgstr ""

#: /resources/settings.xml
msgctxt "#32115"
msgid "Language code for TMDB metadata, e.g. 'en-US', 'fr-FR', 'de-DE'."
msgstr ""

#: /resources/settings.xml
msgctxt "#32016"
msgid "Enter a TMDB language code"
msgstr ""

#: /resources/settings.xml
msgctxt "#32021"
msgid "Enable access to ListenBrainz API"
msgstr ""

#: /resources/settings.xml
msgctxt "#32121"
msgid "Adds a Top songs rail to artist info: the artist's songs most listened to on ListenBrainz, then your most played. Sends the artist's MusicBrainz ID to listenbrainz.org (MetaBrainz); no account or key needed. Off: nothing is sent and the rail is hidden."
msgstr ""

